   CurrentValue = false,
   Flag = "FullAutoBuild",
   Callback = function(Value)
       Settings.FullAutoBuild = Value
       if Value then
           task.spawn(function()
               while Settings.FullAutoBuild do
                   -- Auto Build Flow
                   pcall(function()
                       -- Scan workspace for build points/plots belonging to player
                       local plots = workspace:FindFirstChild("Plots") or workspace:FindFirstChild("Houses")
                       if plots then
                           for _, part in ipairs(plots:GetDescendants()) do
                               if not Settings.FullAutoBuild then break end
                               if part:IsA("ProximityPrompt") or part.Name:lower():find("build") then
                                   fireproximityprompt(part)
                                   task.wait(Settings.BuildDelay / 1000)
                               end
                           end
                       end
                   end)
                   task.wait(0.2)
               end
           end)
       end
   end,
})

