-- 3. Auto Use Abilities Toggle
CreateButton("Auto Use Abilities", 135, function(state)
    Settings.AutoAbilities = state
    if state then
        task.spawn(function()
            while Settings.AutoAbilities do
                pcall(function()
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Events")
                    if remotes then
                        for _, r in ipairs(remotes:GetDescendants()) do
                            if r:IsA("RemoteEvent") and r.Name:lower():find("ability") then
                                r:FireServer()
                            end
                        end
                    end
                end)
                task.wait(2)
            end
        end)
    end
end)

-- 4. Auto Upgrades Toggle
CreateButton("Auto Upgrade", 180, function(state)
    Settings.AutoUpgrade = state
