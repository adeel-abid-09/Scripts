-- Helper to make buttons
local function CreateButton(text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 36)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = MainFrame

    local Corner = Instance.new("UICorner", btn)
    Corner.CornerRadius = UDim.new(0, 6)

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(40, 70, 50)
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.Text = text .. ": ON"
        else
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.Text = text .. ": OFF"
        end
        callback(state)
    end)
    return btn
end

-- 1. Full Auto Build Toggle
CreateButton("Full Auto Build", 45, function(state)
    Settings.AutoBuild = state
    if state then
        task.spawn(function()
            while Settings.AutoBuild do
                pcall(function()
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if not Settings.AutoBuild then break end
                        if obj:IsA("ProximityPrompt") and (obj.ActionText:lower():find("build") or obj.ObjectText:lower():find("build") or obj.Name:lower():find("build")) then
                            fireproximityprompt(obj)
                            task.wait(Settings.BuildDelay)
                        end
                    end
                end)
                task.wait(0.2)
            end
        end)
    end
end)

